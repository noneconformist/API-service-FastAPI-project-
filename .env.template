# 🐘 PostgreSQL
POSTGRES_DB=__REQUIRED__ # Database name
POSTGRES_USER=__REQUIRED__
POSTGRES_PASSWORD=__REQUIRED__
DB_HOST=db
DB_PORT=5432

# 📦 Docker-specific
PG_DATA=/var/lib/postgresql/data
POSTGRES_PORT_HOST=5433

# 🧠 Python runtime
PYTHONUNBUFFERED=1

# FastAPI secret key
FASTAPI_SECRET_KEY=__REQUIRED__

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Database test configuration
TEST_USER=docker_user
TEST_PASS=docker_password
TEST_HOST=db
TEST_PORT=5432
TEST_BASE_DB=postgres
TEST_DB_NAME=test_db
TEST_CLI_DB=test_db_cli
TEST_DB_URL=postgresql://docker_user:docker_password@db:5432/test_db
